{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchproof:schema:observation:1.0",
  "title": "Observation (one required test, one pair, one side)",
  "description": "PROJECT_SPEC.md 8.1, 12.1. One required test in one pair on one side, derived by the host collector from verifier events only (provenance is fixed). It records facts separately and does not decide trust: the stream status of its execution, the pytest lifecycle outcome derived from the report sequence (verdict specification section 3), and what the reviewed check observed. Trust and verdict are defined in docs/architecture/verdict-specification.md and implemented in PP-004.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "pair",
    "side",
    "test_id",
    "nodeid",
    "kind",
    "stream_status",
    "lifecycle_outcome",
    "semantic_outcome",
    "harness_errors",
    "evidence_refs",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/schemaVersion"
    },
    "run_id": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/runId"
    },
    "pair": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/pairIndex"
    },
    "side": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/side"
    },
    "test_id": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/testId"
    },
    "nodeid": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/pytestNodeId"
    },
    "kind": {
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/testKind"
    },
    "stream_status": {
      "description": "Must equal the stream.status of this pair/side's execution record. TRUNCATED, ABSENT and OVER_CAP make only this execution untrusted (OVER_CAP per owner decision D6); MALFORMED and IDENTITY_MISMATCH are global provenance failures.",
      "enum": [
        "COMPLETE",
        "TRUNCATED",
        "MALFORMED",
        "IDENTITY_MISMATCH",
        "OVER_CAP",
        "ABSENT"
      ]
    },
    "lifecycle_outcome": {
      "enum": [
        "COMPLETED",
        "SETUP_ERROR",
        "CALL_ERROR",
        "TEARDOWN_ERROR",
        "SKIPPED",
        "XFAILED",
        "XPASSED",
        "TIMED_OUT",
        "INTERRUPTED",
        "NOT_RUN",
        "NOT_COLLECTED"
      ],
      "description": "INTERRUPTED: the test's report sequence was cut off because the stream ended early. Only possible on a stream that is not COMPLETE."
    },
    "semantic_outcome": {
      "enum": [
        "VIOLATION_CONFIRMED",
        "SECURE",
        "INCONCLUSIVE",
        "PASS",
        "FAIL",
        "NONE"
      ]
    },
    "harness_errors": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MISSING_TERMINAL_OBSERVATION",
          "MULTIPLE_TERMINAL_OBSERVATIONS",
          "SUPPRESSED_TERMINAL_EXCEPTION",
          "MALFORMED_EVIDENCE",
          "ERROR_AFTER_OBSERVATION",
          "OBSERVATION_ON_FUNCTIONAL_TEST",
          "GENERIC_FAILURE_IN_SECURITY_TEST"
        ]
      },
      "description": "Errors caused by the check's own behavior (7.3). Duplicate or missing phase reports are not harness errors: they are protocol violations that make the stream MALFORMED."
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "urn:patchproof:schema:common:1.0#/$defs/evidenceRef"
      }
    },
    "provenance": {
      "description": "INV-09: target stdout, target files, and target-supplied fields are not a representable source.",
      "const": "verifier-event-stream"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "security"
          }
        }
      },
      "then": {
        "properties": {
          "semantic_outcome": {
            "enum": [
              "VIOLATION_CONFIRMED",
              "SECURE",
              "INCONCLUSIVE",
              "NONE"
            ]
          }
        }
      }
    },
    {
      "description": "A functional PASS/FAIL is only meaningful for a completed lifecycle; a timeout or crash is not a FAIL.",
      "if": {
        "properties": {
          "kind": {
            "const": "functional"
          }
        }
      },
      "then": {
        "properties": {
          "semantic_outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "NONE"
            ]
          }
        },
        "if": {
          "properties": {
            "lifecycle_outcome": {
              "not": {
                "const": "COMPLETED"
              }
            }
          }
        },
        "then": {
          "properties": {
            "semantic_outcome": {
              "const": "NONE"
            }
          }
        }
      }
    },
    {
      "description": "No call phase ran, so no observation or functional result can exist.",
      "if": {
        "properties": {
          "lifecycle_outcome": {
            "enum": [
              "SETUP_ERROR",
              "NOT_RUN",
              "NOT_COLLECTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "semantic_outcome": {
            "const": "NONE"
          }
        }
      }
    },
    {
      "description": "A finalized stream reports every collected test to the end.",
      "if": {
        "properties": {
          "stream_status": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle_outcome": {
            "not": {
              "enum": [
                "INTERRUPTED",
                "NOT_RUN",
                "NOT_COLLECTED"
              ]
            }
          }
        }
      }
    },
    {
      "description": "An absent stream produced no reports.",
      "if": {
        "properties": {
          "stream_status": {
            "const": "ABSENT"
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle_outcome": {
            "const": "NOT_RUN"
          },
          "semantic_outcome": {
            "const": "NONE"
          }
        }
      }
    }
  ]
}
