{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchproof:schema:source-manifest:1.0",
  "title": "Source snapshot manifest",
  "description": "PROJECT_SPEC.md 9.2 and 12.2 (source-manifests/). Describes exactly which committed files one read-only snapshot contains and which were excluded, with the full commit and tree IDs, the Git object format, per-file SHA-256, the source tree hash, and the inclusion-profile hash. Deterministic: it carries no timestamps, snapshot IDs, or absolute local paths. Uncommitted changes are never part of a snapshot. Hashes support local consistency checks, not attestation (ADR-007).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "object_format", "requested_revision", "commit_id", "tree_id",
    "git_version", "inclusion_profile", "uncommitted_changes_included", "complete_commit",
    "totals", "source_tree_sha256", "files", "excluded"
  ],
  "properties": {
    "schema_version": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/schemaVersion" },
    "kind": { "const": "source-manifest" },
    "object_format": { "enum": ["sha1", "sha256"] },
    "requested_revision": {
      "description": "The identifier the operator supplied: a full object ID or a fully qualified branch/tag ref. Abbreviations and revision expressions are not representable.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64}|refs/(heads|tags)/[A-Za-z0-9_][A-Za-z0-9_.+/-]{0,240})$"
    },
    "commit_id": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/commitId" },
    "tree_id": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/commitId" },
    "git_version": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/semver" },
    "inclusion_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "secret_policy", "limits", "sha256"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/relativePath" }
        },
        "secret_policy": { "const": "secret-files-1" },
        "limits": {
          "description": "PROJECT_SPEC.md 5.2 source snapshot cap. A run may tighten these values, never exceed them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["max_total_bytes", "max_entries", "max_file_bytes"],
          "properties": {
            "max_total_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
            "max_entries": { "type": "integer", "minimum": 1, "maximum": 20000 },
            "max_file_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
          }
        },
        "sha256": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/sha256" }
      }
    },
    "uncommitted_changes_included": {
      "description": "INV-13 and 9.1: snapshots are built from committed objects only.",
      "const": false
    },
    "complete_commit": {
      "description": "False when any committed entry was excluded: an exported subset is not the entire repository.",
      "type": "boolean"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes", "excluded_count"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "total_bytes": { "type": "integer", "minimum": 0, "maximum": 104857600 },
        "excluded_count": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "source_tree_sha256": {
      "description": "SHA-256 of the canonical JSON serialization of `files`.",
      "$ref": "urn:patchproof:schema:common:1.0#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "git_object_id", "size_bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/treePath" },
          "mode": {
            "description": "Regular files only. Symlinks, gitlinks, and special entries are refused, never exported.",
            "enum": ["100644", "100755"]
          },
          "git_object_id": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/commitId" },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 },
          "sha256": { "$ref": "urn:patchproof:schema:common:1.0#/$defs/sha256" }
        }
      }
    },
    "excluded": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "mode"],
        "properties": {
          "path": { "$ref": "#/$defs/treePath" },
          "reason": { "enum": ["OUTSIDE_SOURCE_SCOPE", "SECRET_FILE_POLICY"] },
          "mode": { "type": "string", "pattern": "^[0-7]{6}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "object_format": { "const": "sha1" } } },
      "then": {
        "properties": {
          "commit_id": { "pattern": "^[0-9a-f]{40}$" },
          "tree_id": { "pattern": "^[0-9a-f]{40}$" },
          "files": { "items": { "properties": { "git_object_id": { "pattern": "^[0-9a-f]{40}$" } } } }
        }
      },
      "else": {
        "properties": {
          "commit_id": { "pattern": "^[0-9a-f]{64}$" },
          "tree_id": { "pattern": "^[0-9a-f]{64}$" },
          "files": { "items": { "properties": { "git_object_id": { "pattern": "^[0-9a-f]{64}$" } } } }
        }
      }
    }
  ],
  "$defs": {
    "treePath": {
      "description": "A validated path from a Git tree: relative, no empty, '.' or '..' segments, no backslash, no control characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.{1,2}(/|$))[^\\u0000-\\u001F\\u007F\\\\]+$"
    }
  }
}
