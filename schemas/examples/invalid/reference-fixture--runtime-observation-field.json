      "authz_sha256": "sha256:a4323e5825cc5abb7b3cdd5899ad002f9400a71644bb1c07c30ea7f2b5884e22",
      "intent": "can_read_document returns True for every authenticated caller and never consults the document. Any signed-in user can read any user's private document (object-level authorization defect, OWASP API1:2023 BOLA)."
    },
    {
      "key": "inadequate",
